{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clientstream",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientstream-db",
      "database_id": "REPLACE_WITH_CLIENTSTREAM_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "SQUARE_WEBHOOK_URL": "https://app.clientstream.io/api/webhooks/square"
  }
}
