{
  "name": "clientstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply clientstream-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply clientstream-db --remote",
    "check:js": "node --check public/app.js && node --check public/print.js && node --check scripts/smoke-production.mjs && node --check scripts/test-square-webhook.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "check:password-crypto": "node --experimental-strip-types scripts/test-password-crypto.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "latest",
    "@types/node": "^22.15.0"
  }
}
