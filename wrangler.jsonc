{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clientstream",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientstream-db",
      "database_id": "19030b2b-655d-4695-b74d-b28c93b25afa",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  }
}
